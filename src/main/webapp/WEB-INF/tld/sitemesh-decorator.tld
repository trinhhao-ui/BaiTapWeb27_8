<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                            https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">

    <tlib-version>3.0</tlib-version>
    <short-name>sitemesh</short-name>
    <uri>http://www.sitemesh.org/decorator</uri>

    <tag>
        <description>Writes a property from the decorated page</description>
        <name>write</name>
        <tag-class>org.sitemesh.tagprocessor.taglib.content.ContentPropertyTag</tag-class>
        <body-content>empty</body-content>
        <attribute>
            <description>The property name to write (e.g., 'title', 'head', 'body')</description>
            <name>property</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
        </attribute>
    </tag>

</taglib>
